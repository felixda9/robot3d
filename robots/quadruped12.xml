<!--
  quadruped12.xml: the quadruped with 12 motors: 3 per leg, like real robot
  dogs (Spot, Unitree Go1, ANYmal). Same torso, thighs, shins and feet as
  quadruped.xml, plus a "roll" joint at each hip that swings the whole leg
  out sideways. That is what lets a robot dog step sideways, catch a sideways
  shove, and roll itself back over after falling on its side (with only
  forward/back leg swings, legs lying flat on the floor can't push it up).

  Conventions (shared by the whole project, see CLAUDE.md):
    * SI units: meters, kilograms, seconds, radians.
    * World frame: +x forward, +y left, +z up.
    * Joint angle 0 = leg hanging straight down. The standing pose is the
      "home" keyframe at the bottom of this file.
    * Only primitive shapes (box, capsule, sphere; plane for the floor).

  Kinematic tree (each "body" is a rigid part; joints connect a body to its parent):

    world
     └─ torso                free joint: 6 DOF
         ├─ FL_hip_link      FL_roll (hinge about x: swings the leg sideways)
         │   └─ FL_thigh     FL_hip  (hinge about y: swings the leg forward/back)
         │       └─ FL_shin  FL_knee (hinge about y: bends the knee)
         ├─ FR_hip_link ... (same for FR, RL, RR)

  Signs (right-hand rule): roll about +x, positive = the foot swings to the
  robot's LEFT (outward for left legs, inward for right legs). Hip and knee
  exactly as in quadruped.xml: positive = the segment swings backward.
-->
<mujoco model="quadruped12">
  <compiler angle="radian" autolimits="true"/>

  <!-- Same physics options as quadruped.xml (see the explanations there). -->
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="100"/>

  <statistic center="0 0 0.2" extent="0.9"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-20"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5" texuniform="true" reflectance="0.2"/>
  </asset>

  <default>
    <default class="robot">
      <!--
        Collision filtering: two geoms collide if
          (A.contype & B.conaffinity) or (B.contype & A.conaffinity) is nonzero.
          floor (MuJoCo default): contype 1, conaffinity 1
          torso + head:           contype 1, conaffinity 2
          leg parts:              contype 3, conaffinity 0
        So everything hits the floor, and legs hit the torso (3 & 2), but legs
        don't hit each other (3 & 0). Unlike quadruped.xml, legs can't pass
        through the body: a policy learning to get up mustn't cheat that way.
        (MuJoCo never collides a body with its own parent, so the hip links,
        attached to the torso, don't count.)
      -->
      <geom contype="3" conaffinity="0" condim="3" friction="1.0 0.005 0.0001"/>

      <!-- armature = rotor inertia, damping = gearbox friction (see quadruped.xml). -->
      <joint type="hinge" axis="0 1 0" armature="0.01" damping="0.1"/>

      <!-- Position actuators (a PD controller in each motor), same as quadruped.xml. -->
      <position kp="40" kv="1.0" forcerange="-10 10" inheritrange="1"/>

      <default class="roll">
        <!-- +-0.8 rad (~46 deg) sideways, in the range of real robot dogs (Spot, ANYmal: ~0.75). -->
        <joint axis="1 0 0" range="-0.8 0.8"/>
      </default>
      <default class="hip">
        <joint range="-1.0 1.8"/>
      </default>
      <default class="knee">
        <joint range="-2.6 0"/>
      </default>

      <default class="torso">
        <geom contype="1" conaffinity="2" rgba="0.25 0.35 0.55 1"/>
      </default>
      <default class="hip_link">
        <!-- The hip motor housing: a short, fat capsule from the roll axis out to the thigh. -->
        <geom type="capsule" size="0.028" mass="0.15" rgba="0.3 0.3 0.34 1"/>
      </default>
      <default class="thigh">
        <geom type="capsule" size="0.022" fromto="0 0 0  0 0 -0.16" mass="0.4" rgba="0.9 0.55 0.2 1"/>
      </default>
      <default class="shin">
        <geom type="capsule" size="0.016" fromto="0 0 0  0 0 -0.16" mass="0.15" rgba="0.85 0.85 0.85 1"/>
      </default>
      <default class="foot">
        <geom type="sphere" size="0.022" pos="0 0 -0.16" mass="0.05" rgba="0.15 0.15 0.15 1"/>
      </default>
    </default>
  </default>

  <worldbody>
    <light name="sun" pos="0 0 3" dir="0 0 -1" directional="true" castshadow="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid"/>

    <body name="torso" pos="0 0 0.4" childclass="robot">
      <freejoint name="root"/>
      <camera name="track" mode="trackcom" pos="0.4 -1.1 0.4" xyaxes="0.94 0.34 0  -0.11 0.30 0.95"/>

      <!-- 0.40 m long, 0.16 m wide, 0.08 m tall (half-extents), as in quadruped.xml. -->
      <geom name="torso" class="torso" type="box" size="0.2 0.08 0.04" mass="4.0"/>
      <geom name="head" class="torso" type="box" pos="0.22 0 0.015" size="0.03 0.055 0.03" mass="0.2"
            rgba="0.95 0.95 0.95 1"/>

      <!--
        Legs. The roll axis runs along the torso's side edge (y = +-0.08); the
        hip link carries the thigh 0.03 m further out, to y = +-0.11, where
        quadruped.xml has its hips, so both robots stand the same way.
      -->
      <body name="FL_hip_link" pos="0.16 0.08 0">
        <joint name="FL_roll" class="roll"/>
        <geom name="FL_hip_link" class="hip_link" fromto="0 0 0  0 0.03 0"/>
        <body name="FL_thigh" pos="0 0.03 0">
          <joint name="FL_hip" class="hip"/>
          <geom name="FL_thigh" class="thigh"/>
          <body name="FL_shin" pos="0 0 -0.16">
            <joint name="FL_knee" class="knee"/>
            <geom name="FL_shin" class="shin"/>
            <geom name="FL_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="FR_hip_link" pos="0.16 -0.08 0">
        <joint name="FR_roll" class="roll"/>
        <geom name="FR_hip_link" class="hip_link" fromto="0 0 0  0 -0.03 0"/>
        <body name="FR_thigh" pos="0 -0.03 0">
          <joint name="FR_hip" class="hip"/>
          <geom name="FR_thigh" class="thigh"/>
          <body name="FR_shin" pos="0 0 -0.16">
            <joint name="FR_knee" class="knee"/>
            <geom name="FR_shin" class="shin"/>
            <geom name="FR_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="RL_hip_link" pos="-0.16 0.08 0">
        <joint name="RL_roll" class="roll"/>
        <geom name="RL_hip_link" class="hip_link" fromto="0 0 0  0 0.03 0"/>
        <body name="RL_thigh" pos="0 0.03 0">
          <joint name="RL_hip" class="hip"/>
          <geom name="RL_thigh" class="thigh"/>
          <body name="RL_shin" pos="0 0 -0.16">
            <joint name="RL_knee" class="knee"/>
            <geom name="RL_shin" class="shin"/>
            <geom name="RL_foot" class="foot"/>
          </body>
        </body>
      </body>

      <body name="RR_hip_link" pos="-0.16 -0.08 0">
        <joint name="RR_roll" class="roll"/>
        <geom name="RR_hip_link" class="hip_link" fromto="0 0 0  0 -0.03 0"/>
        <body name="RR_thigh" pos="0 -0.03 0">
          <joint name="RR_hip" class="hip"/>
          <geom name="RR_thigh" class="thigh"/>
          <body name="RR_shin" pos="0 0 -0.16">
            <joint name="RR_knee" class="knee"/>
            <geom name="RR_shin" class="shin"/>
            <geom name="RR_foot" class="foot"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- One motor per joint, leg by leg (roll, hip, knee). Order here = order of data.ctrl. -->
  <actuator>
    <position name="FL_roll" joint="FL_roll" class="robot"/>
    <position name="FL_hip"  joint="FL_hip"  class="robot"/>
    <position name="FL_knee" joint="FL_knee" class="robot"/>
    <position name="FR_roll" joint="FR_roll" class="robot"/>
    <position name="FR_hip"  joint="FR_hip"  class="robot"/>
    <position name="FR_knee" joint="FR_knee" class="robot"/>
    <position name="RL_roll" joint="RL_roll" class="robot"/>
    <position name="RL_hip"  joint="RL_hip"  class="robot"/>
    <position name="RL_knee" joint="RL_knee" class="robot"/>
    <position name="RR_roll" joint="RR_roll" class="robot"/>
    <position name="RR_hip"  joint="RR_hip"  class="robot"/>
    <position name="RR_knee" joint="RR_knee" class="robot"/>
  </actuator>

  <keyframe>
    <!--
      "home": standing pose (legs straight under the hips sideways, the same
      hip/knee angles as quadruped.xml), released 0.4 m up.
      qpos = torso xyz, torso quaternion (w x y z), then per leg roll hip knee.
    -->
    <key name="home"
         qpos="0 0 0.4  1 0 0 0
               0 0.7 -1.4  0 0.7 -1.4  0 0.7 -1.4  0 0.7 -1.4"
         ctrl="0 0.7 -1.4  0 0.7 -1.4  0 0.7 -1.4  0 0.7 -1.4"/>

    <!-- Pose presets (the web UI's pose buttons apply only ctrl), as in quadruped.xml ... -->
    <key name="crouch" ctrl="0 1.1 -2.2  0 1.1 -2.2  0 1.1 -2.2  0 1.1 -2.2"/>
    <key name="tall"   ctrl="0 0.35 -0.7  0 0.35 -0.7  0 0.35 -0.7  0 0.35 -0.7"/>
    <key name="sit"    ctrl="0 0.25 -0.5  0 0.25 -0.5  0 1.5 -2.5  0 1.5 -2.5"/>
    <!-- ... plus one only this robot can do: feet spread out sideways (roll outward 0.3 rad). -->
    <key name="wide"   ctrl="0.3 0.7 -1.4  -0.3 0.7 -1.4  0.3 0.7 -1.4  -0.3 0.7 -1.4"/>
  </keyframe>
</mujoco>
